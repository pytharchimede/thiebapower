APP_URL=https://thiebapower.com
DB_DSN=mysql:host=localhost;dbname=thiebapower;charset=utf8mb4
DB_USER=
DB_PASSWORD=
PAIEMENTPRO_MERCHANT_ID=
PAIEMENTPRO_SECRET_KEY=
ADMIN_PASSWORD_HASH=
HEYCHARGE_API_BASE=https://openapi.heycharge.global
# Configurer la clé réelle uniquement sur le serveur.
HEYCHARGE_WEBHOOK_URL=https://thiebapower.com/api/heycharge/callback

HEYCHARGE_API_KEY=
# Générer une valeur aléatoire unique de 32 octets minimum (ex. 64 caractères hexadécimaux).
PAYMENT_CALLBACK_SECRET=
ADMIN_USERNAME=admin
PAIEMENTPRO_SANDBOX_WSDL=
PAIEMENTPRO_SANDBOX_PROCESSING_URL=
PAIEMENTPRO_SANDBOX_MERCHANT_ID=
PAIEMENTPRO_SANDBOX_SECRET_KEY=
PAIEMENTPRO_SANDBOX_PAYOUT_WSDL=
PAYMENT_LAB_PAYIN_ENABLED=0
PAYMENT_LAB_PAYOUT_ENABLED=0
PUBLIC_RENTALS_ENABLED=0
SIMULATED_RENTALS_ENABLED=0
AUTOMATIC_REFUNDS_ENABLED=0
## Existing Thiebapower mailbox receiving provider receipts for rentals without email.
PAIEMENTPRO_CUSTOMER_EMAIL_FALLBACK=

# XPaye : identifiants privés utilisés pour obtenir le token Bearer du transfert interne.
# Renseigner uniquement dans le .env du serveur ; ne jamais publier les valeurs.
XPAYE_LOGIN=
XPAYE_PASSWORD=

# Optionnel : bundle de certificats CA PEM pour vérifier HTTPS XPaye (chemin absolu).
XPAYE_CA_BUNDLE=
